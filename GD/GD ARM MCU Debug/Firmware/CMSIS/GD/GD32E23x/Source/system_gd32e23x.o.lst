  76:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                         volatile uint32_t i,reg;            \
  77:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                         if(0U != (__delay)){                   \
  78:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                             for(i=0U; i<(__delay); i++){       \
  79:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                             }                               \
  80:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                             reg = RCU_CFG0;                 \
  81:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                             reg &= ~(RCU_CFG0_AHBPSC);      \
  82:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                             reg |= RCU_AHB_CKSYS_DIV2;      \
  83:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                             RCU_CFG0 = reg;                 \
  84:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                             for(i=0U; i<(__delay); i++){       \
  85:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                             }                               \
  86:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                             reg = RCU_CFG0;                 \
  87:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                             reg &= ~(RCU_CFG0_AHBPSC);      \
  88:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                             reg |= RCU_AHB_CKSYS_DIV1;      \
  89:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                             RCU_CFG0 = reg;                 \
  90:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                     }                                       \
  91:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                 }while(0U)
