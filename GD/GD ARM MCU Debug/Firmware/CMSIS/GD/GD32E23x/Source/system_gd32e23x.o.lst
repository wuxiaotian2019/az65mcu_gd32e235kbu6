  52:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** /* The following is to prevent Vcore fluctuations caused by frequency switching.
  53:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****    It is strongly recommended to include it to avoid issues caused by self-removal.
  54:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** */
  55:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** #define RCU_MODIFY(__delay)     do{                                     \
  56:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                     volatile uint32_t i,reg;            \
  57:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                     if(0U != (__delay)){                   \
  58:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                         reg = RCU_CFG0;                 \
  59:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                         reg &= ~(RCU_CFG0_AHBPSC);      \
  60:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                         /* CK_AHB = SYSCLK/2 */         \
  61:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                         reg |= RCU_AHB_CKSYS_DIV2;      \
  62:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                         RCU_CFG0 = reg;                 \
  63:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                         for(i=0U; i<(__delay); i++){       \
  64:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                         }                               \
  65:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                         reg = RCU_CFG0;                 \
  66:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                         reg &= ~(RCU_CFG0_AHBPSC);      \
  67:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                         reg |= RCU_AHB_CKSYS_DIV4;      \
  68:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                         /* CK_AHB = SYSCLK/4 */         \
  69:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                         RCU_CFG0 = reg;                 \
  70:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                         for(i=0U; i<(__delay); i++){       \
  71:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                         }                               \
  72:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                     }                                   \
  73:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                                 }while(0U)
