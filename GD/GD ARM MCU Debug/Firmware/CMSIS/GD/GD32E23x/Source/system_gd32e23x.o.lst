 367:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** /*!
 368:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     \brief      configure the system clock to 8M by IRC8M
 369:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     \param[in]  none
 370:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     \param[out] none
 371:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     \retval     none
 372:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     \note       This function contains scenarios leading to an infinite loop.
 373:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                 Modify according to the use's actual usage scenarios.
 374:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** */
 375:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** static void system_clock_8m_irc8m(void)
 376:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** {
 377:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     uint32_t timeout = 0U;
 378:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     uint32_t stab_flag = 0U;
 379:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     __IO uint32_t reg_temp;
 380:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     
 381:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* enable IRC8M */
 382:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     RCU_CTL0 |= RCU_CTL0_IRC8MEN;
 383:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** 
 384:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* wait until IRC8M is stable or the startup time is longer than IRC8M_STARTUP_TIMEOUT */
 385:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     do{
 386:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****         timeout++;
 387:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****         stab_flag = (RCU_CTL0 & RCU_CTL0_IRC8MSTB);
 388:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     }
 389:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     while((0U == stab_flag) && (IRC8M_STARTUP_TIMEOUT != timeout));
 390:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** 
 391:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* if fail */
 392:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     if(0U == (RCU_CTL0 & RCU_CTL0_IRC8MSTB)){
 393:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****         while(1){
 394:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****         }
 395:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     }
 396:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** 
 397:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* AHB = SYSCLK */
 398:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     RCU_CFG0 |= RCU_AHB_CKSYS_DIV1;
 399:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* APB2 = AHB */
 400:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     RCU_CFG0 |= RCU_APB2_CKAHB_DIV1;
 401:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* APB1 = AHB */
 402:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     RCU_CFG0 |= RCU_APB1_CKAHB_DIV1;
 403:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     
 404:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     reg_temp = RCU_CFG0;
 405:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* select IRC8M as system clock */
 406:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     reg_temp &= ~RCU_CFG0_SCS;
 407:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     reg_temp |= RCU_CKSYSSRC_IRC8M;
 408:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     RCU_CFG0 = reg_temp;
 409:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     
 410:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* wait until IRC8M is selected as system clock */
 411:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     while(RCU_SCSS_IRC8M != (RCU_CFG0 & RCU_CFG0_SCSS)){
 412:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     }
 413:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** }
