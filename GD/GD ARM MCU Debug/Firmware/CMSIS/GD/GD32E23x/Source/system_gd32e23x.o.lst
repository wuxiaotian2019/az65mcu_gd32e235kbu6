 191:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** /*!
 192:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     \brief      configure the system clock to 8M by HXTAL
 193:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     \param[in]  none
 194:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     \param[out] none
 195:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     \retval     none
 196:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     \note       This function contains scenarios leading to an infinite loop.
 197:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****                 Modify according to the use's actual usage scenarios.
 198:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** */
 199:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** static void system_clock_8m_hxtal(void)
 200:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** {
 201:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     uint32_t timeout = 0U;
 202:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     uint32_t stab_flag = 0U;
 203:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     __IO uint32_t reg_temp;
 204:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** 
 205:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* enable HXTAL */
 206:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     RCU_CTL0 |= RCU_CTL0_HXTALEN;
 207:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     
 208:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* wait until HXTAL is stable or the startup time is longer than HXTAL_STARTUP_TIMEOUT */
 209:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     do{
 210:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****         timeout++;
 211:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****         stab_flag = (RCU_CTL0 & RCU_CTL0_HXTALSTB);
 212:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     }
 213:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     while((0U == stab_flag) && (HXTAL_STARTUP_TIMEOUT != timeout));    
 214:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* if fail */
 215:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     if(0U == (RCU_CTL0 & RCU_CTL0_HXTALSTB)){
 216:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****         while(1){
 217:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****         }
 218:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     }
 219:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     
 220:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* HXTAL is stable */
 221:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* AHB = SYSCLK */
 222:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     RCU_CFG0 |= RCU_AHB_CKSYS_DIV1;
 223:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* APB2 = AHB */
 224:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     RCU_CFG0 |= RCU_APB2_CKAHB_DIV1;
 225:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* APB1 = AHB */
 226:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     RCU_CFG0 |= RCU_APB1_CKAHB_DIV1;
 227:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c **** 
 228:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     reg_temp = RCU_CFG0;
 229:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* select HXTAL as system clock */
 230:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     reg_temp &= ~RCU_CFG0_SCS;
 231:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     reg_temp |= RCU_CKSYSSRC_HXTAL;
 232:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     RCU_CFG0 = reg_temp;
 233:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     
 234:../Firmware/CMSIS/GD/GD32E23x/Source/system_gd32e23x.c ****     /* wait until HXTAL is selected as system clock */
