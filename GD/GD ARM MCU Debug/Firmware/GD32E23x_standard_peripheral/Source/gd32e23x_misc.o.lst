 198:../Firmware/CMSIS/core_cm23.h **** #define     __OM     volatile            /*! Defines 'write only' structure member permissions */
 199:../Firmware/CMSIS/core_cm23.h **** #define     __IOM    volatile            /*! Defines 'read / write' structure member permissions */
