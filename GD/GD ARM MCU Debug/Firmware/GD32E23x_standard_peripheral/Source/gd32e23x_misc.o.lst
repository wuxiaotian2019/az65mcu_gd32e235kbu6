 193:../Firmware/CMSIS/core_cm23.h **** #define     __O     volatile             /*!< Defines 'write only' permissions */
 194:../Firmware/CMSIS/core_cm23.h **** #define     __IO    volatile             /*!< Defines 'read / write' permissions */
 195:../Firmware/CMSIS/core_cm23.h **** 
