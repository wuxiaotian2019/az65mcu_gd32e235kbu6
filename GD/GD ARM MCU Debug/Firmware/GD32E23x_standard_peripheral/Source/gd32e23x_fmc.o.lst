 504:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****     \brief      program the FMC user option byte
 505:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****                 this function can only clear the corresponding bits to be 0 rather than 1.
 506:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****                 the function ob_erase is used to set all the bits to be 1.
 507:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****     \param[in]  ob_user: user option byte
 508:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****                 one or more parameters (bitwise AND) can be selected which are shown as below:
 509:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****       \arg        OB_FWDGT_HW: hardware free watchdog timer
 510:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****       \arg        OB_DEEPSLEEP_RST: no reset when entering deepsleep mode
 511:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****       \arg        OB_STDBY_RST: no reset when entering standby mode
 512:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****       \arg        OB_BOOT1_SET_1: BOOT1 bit is 1
 513:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****       \arg        OB_VDDA_DISABLE: disable VDDA monitor
 514:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****       \arg        OB_SRAM_PARITY_ENABLE: enable sram parity check
 515:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****     \param[out] none
 516:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****     \retval     fmc_state: state of FMC
 517:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****       \arg        FMC_READY: the operation has been completed
 518:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****       \arg        FMC_BUSY: the operation is in progress
 519:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****       \arg        FMC_PGERR: program error
 520:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****       \arg        FMC_PGAERR: program alignment error
 521:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****       \arg        FMC_WPERR: erase/program protection error
 522:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****       \arg        FMC_TOERR: timeout error
 523:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c ****       \arg        FMC_OB_HSPC: option byte security protection code high
 524:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_fmc.c **** */
