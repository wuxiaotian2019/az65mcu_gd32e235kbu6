  89:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rcu.c ****       \arg        RCU_RTC: RTC clock
  90:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rcu.c ****       \arg        RCU_DBGMCU: DBGMCU clock
  91:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rcu.c ****     \param[out] none
