 424:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c **** /*!
 425:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****     \brief      get RTC alarm
 426:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****     \param[in]  none
 427:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****     \param[out] rtc_alarm_time: pointer to a rtc_alarm_struct structure which contains
 428:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                 parameters for RTC alarm configuration
 429:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                 members of the structure and the member values are shown as below:
 430:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_alarm_mask: RTC_ALARM_NONE_MASK, RTC_ALARM_DATE_MASK, RTC_ALARM_HOUR_MASK
 431:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                                   RTC_ALARM_MINUTE_MASK, RTC_ALARM_SECOND_MASK, RTC_ALARM_ALL_MASK
 432:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_weekday_or_date: RTC_ALARM_DATE_SELECTED, RTC_ALARM_WEEKDAY_SELECTED
 433:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_alarm_day: 1) 0x1 - 0x31(BCD format) if RTC_ALARM_DATE_SELECTED is set
 434:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                                  2) RTC_MONDAY, RTC_TUESDAY, RTC_WEDSDAY, RTC_THURSDAY, RTC_FRIDAY,
 435:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                                     RTC_SATURDAY, RTC_SUNDAY if RTC_ALARM_WEEKDAY_SELECTED is set
 436:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_alarm_hour: 0x0 - 0x12(BCD format) or 0x0 - 0x23(BCD format) depending on the
 437:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_alarm_minute: 0x0 - 0x59(BCD format)
 438:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_alarm_second: 0x0 - 0x59(BCD format)
 439:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_am_pm: RTC_AM, RTC_PM
 440:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****     \retval     none
 441:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c **** */
