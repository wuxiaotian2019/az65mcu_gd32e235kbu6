  89:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c **** /*!
  90:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****     \brief      initialize RTC registers
  91:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****     \param[in]  rtc_initpara_struct: pointer to a rtc_parameter_struct structure which contains
  92:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                 parameters for initialization of the rtc peripheral
  93:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                 members of the structure and the member values are shown as below:
  94:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_year: 0x0 - 0x99(BCD format)
  95:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_month: RTC_JAN, RTC_FEB, RTC_MAR, RTC_APR, RTC_MAY, RTC_JUN,
  96:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                              RTC_JUL, RTC_AUG, RTC_SEP, RTC_OCT, RTC_NOV, RTC_DEC
  97:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_date: 0x1 - 0x31(BCD format)
  98:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_day_of_week: RTC_MONDAY, RTC_TUESDAY, RTC_WEDSDAY, RTC_THURSDAY
  99:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                                    RTC_FRIDAY, RTC_SATURDAY, RTC_SUNDAY
 100:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_hour: 0x0 - 0x12(BCD format) or 0x0 - 0x23(BCD format) depending on the rtc_d
 101:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_minute: 0x0 - 0x59(BCD format)
 102:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_second: 0x0 - 0x59(BCD format)
 103:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_factor_asyn: 0x0 - 0x7F
 104:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_factor_syn: 0x0 - 0x7FFF
 105:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_am_pm: RTC_AM, RTC_PM
 106:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_display_format: RTC_24HOUR, RTC_12HOUR
 107:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****     \param[out] none
 108:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****     \retval     ErrStatus: ERROR or SUCCESS
 109:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c **** */
