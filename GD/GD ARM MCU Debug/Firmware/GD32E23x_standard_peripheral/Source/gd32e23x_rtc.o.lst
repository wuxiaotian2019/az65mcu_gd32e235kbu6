 235:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c **** /*!
 236:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****     \brief      get current time and date
 237:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****     \param[in]  none
 238:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****     \param[out] rtc_initpara_struct: pointer to a rtc_parameter_struct structure which contains
 239:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                 parameters for initialization of the rtc peripheral
 240:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                 members of the structure and the member values are shown as below:
 241:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_year: 0x0 - 0x99(BCD format)
 242:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_month: RTC_JAN, RTC_FEB, RTC_MAR, RTC_APR, RTC_MAY, RTC_JUN,
 243:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                              RTC_JUL, RTC_AUG, RTC_SEP, RTC_OCT, RTC_NOV, RTC_DEC
 244:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_date: 0x1 - 0x31(BCD format)
 245:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_day_of_week: RTC_MONDAY, RTC_TUESDAY, RTC_WEDSDAY, RTC_THURSDAY
 246:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                                    RTC_FRIDAY, RTC_SATURDAY, RTC_SUNDAY
 247:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_hour: 0x0 - 0x12(BCD format) or 0x0 - 0x23(BCD format) depending on the rtc_d
 248:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_minute: 0x0 - 0x59(BCD format)
 249:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_second: 0x0 - 0x59(BCD format)
 250:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_factor_asyn: 0x0 - 0x7F
 251:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_factor_syn: 0x0 - 0x7FFF
 252:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_am_pm: RTC_AM, RTC_PM
 253:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****                   rtc_display_format: RTC_24HOUR, RTC_12HOUR
 254:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c ****     \retval     none
 255:../Firmware/GD32E23x_standard_peripheral/Source/gd32e23x_rtc.c **** */
