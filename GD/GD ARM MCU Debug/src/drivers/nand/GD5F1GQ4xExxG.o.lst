  23:../inc/Spi_nand_driver.h **** #define NAND_WRITEENABLE				0x06
  24:../inc/Spi_nand_driver.h **** #define NAND_WEITEDISABLE				0x04
  25:../inc/Spi_nand_driver.h **** #define NAND_GETREGS					0x0F
  26:../inc/Spi_nand_driver.h **** #define NAND_SETREGS					0x1F
  27:../inc/Spi_nand_driver.h **** #define NAND_PAGEREADTOCATCH				0x13
  28:../inc/Spi_nand_driver.h **** #define NAND_NEXTPAGECACHEREAD				0x31
  29:../inc/Spi_nand_driver.h **** #define NAND_LASTPAGECACHEREAD				0x3F
  30:../inc/Spi_nand_driver.h **** #define NAND_READFROMCATCH				0x03
  31:../inc/Spi_nand_driver.h **** #define NAND_READID					0x9F
  32:../inc/Spi_nand_driver.h **** #define NAND_PROGRAMLOAD				0x02
  33:../inc/Spi_nand_driver.h **** #define NAND_PROGRAMEXECUTE				0x10
  34:../inc/Spi_nand_driver.h **** #define NAND_PROGRAMLOADRANDOMDATA			0x84
  35:../inc/Spi_nand_driver.h **** #define NAND_BLOCKERASE					0xD8
  36:../inc/Spi_nand_driver.h **** #define NAND_RESET					0xFF
  37:../inc/Spi_nand_driver.h **** #define DUMMY_BYTE					0xA5
  38:../inc/Spi_nand_driver.h **** 
  39:../inc/Spi_nand_driver.h **** #define NAND_OK	0
  40:../inc/Spi_nand_driver.h **** #define NAND_FAIL 1
  41:../inc/Spi_nand_driver.h **** 
