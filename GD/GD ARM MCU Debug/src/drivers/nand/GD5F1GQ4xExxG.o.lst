  43:../inc/Spi_nand_driver.h **** #define READ_NANDFLASH_ECC_ERROR			0x9A
  44:../inc/Spi_nand_driver.h **** #endif
  45:../inc/Spi_nand_driver.h **** /* NAND regs add */
  46:../inc/Spi_nand_driver.h **** #define NAND_REGS_PROTECTION				0xA0
  47:../inc/Spi_nand_driver.h **** #define NAND_REGS_FEATURE				0xB0
  48:../inc/Spi_nand_driver.h **** #define NAND_REGS_STATUS				0xC0
