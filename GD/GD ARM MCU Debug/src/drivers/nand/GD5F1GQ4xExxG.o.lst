  58:../inc/Spi_nand_driver.h **** /* 00 No errors	*/
  59:../inc/Spi_nand_driver.h **** /* 01 Bit error detected and corrected, error bit number = 1~7 */
  60:../inc/Spi_nand_driver.h **** /* 10 Bit errors greater than 8 bits detected and not corrected	*/
  61:../inc/Spi_nand_driver.h **** /* 11 Bit error detected and corrected, error bit number = 8 */
  62:../inc/Spi_nand_driver.h **** #define NAND_STATUS_ECCS2				0x40
  63:../inc/Spi_nand_driver.h **** #define NAND_STATUS_ECCS1				0x20
  64:../inc/Spi_nand_driver.h **** #define NAND_STATUS_ECCS0				0x10
  65:../inc/Spi_nand_driver.h **** #define NAND_STATUS_PROGRAMFAIL				0x08	/* program fail */
  66:../inc/Spi_nand_driver.h **** #define NAND_STATUS_ERASEFAIL				0x04	/* erase fail */
  67:../inc/Spi_nand_driver.h **** #define NAND_STATUS_WEL					0x02	/* write enable */
  68:../inc/Spi_nand_driver.h **** /* Busy:PROGRAM EXECUTE, PAGE READ, BLOCK ERASE, RESET */
  69:../inc/Spi_nand_driver.h **** #define NAND_STATUS_QIP					0x01
