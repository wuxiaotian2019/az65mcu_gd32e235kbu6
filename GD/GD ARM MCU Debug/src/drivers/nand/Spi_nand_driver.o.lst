  67:../inc/Spi_nand_driver.h **** #define NAND_STATUS_WEL					0x02	/* write enable */
  68:../inc/Spi_nand_driver.h **** /* Busy:PROGRAM EXECUTE, PAGE READ, BLOCK ERASE, RESET */
  69:../inc/Spi_nand_driver.h **** #define NAND_STATUS_QIP					0x01
