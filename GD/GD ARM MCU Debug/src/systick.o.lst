1131:../Firmware/CMSIS/core_cm23.h **** /**
1132:../Firmware/CMSIS/core_cm23.h ****   \brief   Mask and shift a bit field value for use in a register bit range.
1133:../Firmware/CMSIS/core_cm23.h ****   \param[in] field  Name of the register bit field.
1134:../Firmware/CMSIS/core_cm23.h ****   \param[in] value  Value of the bit field. This parameter is interpreted as an uint32_t type.
1135:../Firmware/CMSIS/core_cm23.h ****   \return           Masked and shifted value.
1136:../Firmware/CMSIS/core_cm23.h **** */
1137:../Firmware/CMSIS/core_cm23.h **** #define _VAL2FLD(field, value)    (((uint32_t)(value) << field ## _Pos) & field ## _Msk)
1138:../Firmware/CMSIS/core_cm23.h **** 
1139:../Firmware/CMSIS/core_cm23.h **** /**
1140:../Firmware/CMSIS/core_cm23.h ****   \brief     Mask and shift a register value to extract a bit filed value.
1141:../Firmware/CMSIS/core_cm23.h ****   \param[in] field  Name of the register bit field.
1142:../Firmware/CMSIS/core_cm23.h ****   \param[in] value  Value of register. This parameter is interpreted as an uint32_t type.
1143:../Firmware/CMSIS/core_cm23.h ****   \return           Masked and shifted bit field value.
1144:../Firmware/CMSIS/core_cm23.h **** */
1145:../Firmware/CMSIS/core_cm23.h **** #define _FLD2VAL(field, value)    (((uint32_t)(value) & field ## _Msk) >> field ## _Pos)
1146:../Firmware/CMSIS/core_cm23.h **** 
1147:../Firmware/CMSIS/core_cm23.h **** /*@} end of group CMSIS_core_bitfield */
