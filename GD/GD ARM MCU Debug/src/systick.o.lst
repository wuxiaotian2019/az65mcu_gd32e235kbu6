 223:../Firmware/CMSIS/core_cm23.h ****   \defgroup   CMSIS_CORE  Status and Control Registers
 224:../Firmware/CMSIS/core_cm23.h ****   \brief      Core Register type definitions.
 225:../Firmware/CMSIS/core_cm23.h ****   @{
 226:../Firmware/CMSIS/core_cm23.h ****  */
 227:../Firmware/CMSIS/core_cm23.h **** 
 228:../Firmware/CMSIS/core_cm23.h **** /**
 229:../Firmware/CMSIS/core_cm23.h ****   \brief  Union type to access the Application Program Status Register (APSR).
 230:../Firmware/CMSIS/core_cm23.h ****  */
 231:../Firmware/CMSIS/core_cm23.h **** typedef union
 232:../Firmware/CMSIS/core_cm23.h **** {
 233:../Firmware/CMSIS/core_cm23.h ****   struct
 234:../Firmware/CMSIS/core_cm23.h ****   {
 235:../Firmware/CMSIS/core_cm23.h ****     uint32_t _reserved0:28;              /*!< bit:  0..27  Reserved */
 236:../Firmware/CMSIS/core_cm23.h ****     uint32_t V:1;                        /*!< bit:     28  Overflow condition code flag */
 237:../Firmware/CMSIS/core_cm23.h ****     uint32_t C:1;                        /*!< bit:     29  Carry condition code flag */
 238:../Firmware/CMSIS/core_cm23.h ****     uint32_t Z:1;                        /*!< bit:     30  Zero condition code flag */
 239:../Firmware/CMSIS/core_cm23.h ****     uint32_t N:1;                        /*!< bit:     31  Negative condition code flag */
 240:../Firmware/CMSIS/core_cm23.h ****   } b;                                   /*!< Structure used for bit  access */
 241:../Firmware/CMSIS/core_cm23.h ****   uint32_t w;                            /*!< Type      used for word access */
 242:../Firmware/CMSIS/core_cm23.h **** } APSR_Type;
 243:../Firmware/CMSIS/core_cm23.h **** 
 244:../Firmware/CMSIS/core_cm23.h **** /* APSR Register Definitions */
 245:../Firmware/CMSIS/core_cm23.h **** #define APSR_N_Pos                         31U                                            /*!< APSR
 246:../Firmware/CMSIS/core_cm23.h **** #define APSR_N_Msk                         (1UL << APSR_N_Pos)                            /*!< APSR
 247:../Firmware/CMSIS/core_cm23.h **** 
 248:../Firmware/CMSIS/core_cm23.h **** #define APSR_Z_Pos                         30U                                            /*!< APSR
 249:../Firmware/CMSIS/core_cm23.h **** #define APSR_Z_Msk                         (1UL << APSR_Z_Pos)                            /*!< APSR
 250:../Firmware/CMSIS/core_cm23.h **** 
 251:../Firmware/CMSIS/core_cm23.h **** #define APSR_C_Pos                         29U                                            /*!< APSR
 252:../Firmware/CMSIS/core_cm23.h **** #define APSR_C_Msk                         (1UL << APSR_C_Pos)                            /*!< APSR
 253:../Firmware/CMSIS/core_cm23.h **** 
 254:../Firmware/CMSIS/core_cm23.h **** #define APSR_V_Pos                         28U                                            /*!< APSR
 255:../Firmware/CMSIS/core_cm23.h **** #define APSR_V_Msk                         (1UL << APSR_V_Pos)                            /*!< APSR
 256:../Firmware/CMSIS/core_cm23.h **** 
 257:../Firmware/CMSIS/core_cm23.h **** 
 258:../Firmware/CMSIS/core_cm23.h **** /**
 259:../Firmware/CMSIS/core_cm23.h ****   \brief  Union type to access the Interrupt Program Status Register (IPSR).
 260:../Firmware/CMSIS/core_cm23.h ****  */
 261:../Firmware/CMSIS/core_cm23.h **** typedef union
 262:../Firmware/CMSIS/core_cm23.h **** {
 263:../Firmware/CMSIS/core_cm23.h ****   struct
 264:../Firmware/CMSIS/core_cm23.h ****   {
 265:../Firmware/CMSIS/core_cm23.h ****     uint32_t ISR:9;                      /*!< bit:  0.. 8  Exception number */
 266:../Firmware/CMSIS/core_cm23.h ****     uint32_t _reserved0:23;              /*!< bit:  9..31  Reserved */
 267:../Firmware/CMSIS/core_cm23.h ****   } b;                                   /*!< Structure used for bit  access */
 268:../Firmware/CMSIS/core_cm23.h ****   uint32_t w;                            /*!< Type      used for word access */
 269:../Firmware/CMSIS/core_cm23.h **** } IPSR_Type;
 270:../Firmware/CMSIS/core_cm23.h **** 
 271:../Firmware/CMSIS/core_cm23.h **** /* IPSR Register Definitions */
 272:../Firmware/CMSIS/core_cm23.h **** #define IPSR_ISR_Pos                        0U                                            /*!< IPSR
 273:../Firmware/CMSIS/core_cm23.h **** #define IPSR_ISR_Msk                       (0x1FFUL /*<< IPSR_ISR_Pos*/)                  /*!< IPSR
 274:../Firmware/CMSIS/core_cm23.h **** 
